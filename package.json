{
  "name": "vinodbiradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "bun run --bun biome lint .",
    "format": "bun run --bun biome format --write .",
    "format:check": "bun run --bun biome format .",
    "typecheck": "bun run --bun tsc --noEmit",
    "check": "bun run --bun biome check . && bun run typecheck"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
